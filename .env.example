# Copy to .env and fill in. `docker compose` reads this automatically.

# Required — the hypothesis pipeline calls the Anthropic API.
ANTHROPIC_API_KEY=

# SaaS runtime. Production refuses to start when required values are absent.
APP_ENV=development
APP_BASE_URL=http://localhost:5173
SESSION_SECRET=development-only-change-me
DEV_AUTH_ENABLED=true
# Optional private package implementing the public extension contract.
CAUSALITY_EXTENSION_MODULE=
DATABASE_URL=sqlite:///./causality.sqlite
REDIS_URL=redis://localhost:6379/0

# WorkOS AuthKit (required in production)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# ClickHouse Cloud (required in production)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

# Optional — override the model (defaults to claude-sonnet-4-6).
# CAUSALITY_MODEL=claude-sonnet-4-6

# Optional — where the browser reaches the backend (defaults to localhost:8000).
# VITE_API_BASE=http://localhost:8000
