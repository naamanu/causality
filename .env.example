# Copy to .env and fill in. `docker compose` reads this automatically.

# Required — the hypothesis pipeline calls the Anthropic API.
ANTHROPIC_API_KEY=

# Optional — override the model (defaults to claude-sonnet-4-6).
# CAUSALITY_MODEL=claude-sonnet-4-6

# Optional — where the browser reaches the backend (defaults to localhost:8000).
# VITE_API_BASE=http://localhost:8000
